    "R2":  {"value": "1k (base Q1)", "pins": ["1", "2"]},
    "R3":  {"value": "100k (divisor VBAT, alto)", "pins": ["1", "2"]},
    "R4":  {"value": "100k (divisor VBAT, bajo)", "pins": ["1", "2"]},
    "C1":  {"value": "100 nF (filtro ADC, opcional)", "pins": ["1", "2"]}
  },
  "nets": {
    "VBUS":    ["MCU.5V", "TP.IN+", "D1.K"],
    "GND":     ["MCU.G", "TP.IN-", "TP.OUT-", "LCD.GND", "Q1.E", "SW1.2", "SW2.2", "SW3.2", "R4.2", "C1.2"],
