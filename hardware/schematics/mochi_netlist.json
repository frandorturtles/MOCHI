    "TFT_MOSI": ["MCU.IO7", "LCD.SDA"],
    "TFT_CS":  ["MCU.IO10", "LCD.CS"],
    "BUZZER":  ["MCU.IO20", "R2.1"],
    "BUZ_B":   ["R2.2", "Q1.B"],
