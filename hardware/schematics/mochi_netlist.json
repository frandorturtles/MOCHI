    "Q1":  {"value": "Transistor NPN BC547 / 2N2222 / S8050", "pins": ["B", "C", "E"]},
    "BZ":  {"value": "Buzzer pasivo 3-5 V", "pins": ["+", "-"]},
    "SW1": {"value": "Pulsador tact 6x6 mm (estrella A)", "pins": ["1", "2"]},
    "SW2": {"value": "Pulsador tact 6x6 mm (estrella B)", "pins": ["1", "2"]},
    "SW3": {"value": "Pulsador tact 6x6 mm (estrella C)", "pins": ["1", "2"]},
